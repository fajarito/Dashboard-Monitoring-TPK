# Contoh Secret — JANGAN commit nilai nyata.
# Salin ke secret.yaml (gitignored) atau buat langsung via oc:
#
#   oc create secret generic dashboard-tpk-db \
#     --from-literal=DATABASE_URL_SIGA='postgres://USER:PASS@HOST:5432/sigabaru' \
#     --from-literal=DATABASE_URL_WILAYAH='postgres://USER:PASS@HOST:5432/pk2025' \
#     --from-literal=DATABASE_URL_DWH='postgres://USER:PASS@HOST:5432/dwh_pk2025'
#
# Jangan commit URL database / password ke git.
apiVersion: v1
kind: Secret
metadata:
  name: dashboard-tpk-db
  labels:
    app: dashboard-monitoring-tpk
type: Opaque
stringData:
  DATABASE_URL_SIGA: "postgres://USER:PASSWORD@HOST_SIGA:5432/sigabaru"
  DATABASE_URL_WILAYAH: "postgres://USER:PASSWORD@HOST_WILAYAH:5432/pk2025"
  DATABASE_URL_DWH: "postgres://USER:PASSWORD@HOST_DWH:5432/dwh_pk2025"
