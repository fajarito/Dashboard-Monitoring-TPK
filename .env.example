# Salin ke .env.local — jangan commit secret.

# --- Portal PKB (detail jabatan / kontak / foto) ---
# Base UAT (default di kode jika kosong):
# PKB_PORTAL_API_BASE_URL=https://api-portal.apps.ocp-uat.bkkbn.go.id
#
# Bearer token portal — WAJIB untuk data live. Jangan tulis "Bearer " di value.
# Tanpa token:
# - NIP demo 196803291988032003 / KTP demo 5171046903680003 → stub lokal
# - selain itu → fallback field mock TPK
# Lookup live: prefer NIP 18 digit, else ktp=<NIK 16 digit> (bukan kode wilayah).
# PKB_PORTAL_API_TOKEN=
#
# Alias opsional:
# PKB_PORTAL_API_KEY=

# Foto SIMSDM (default):
# SIMSDM_FOTO_BASE_URL=https://simsdm.bkkbn.go.id/assets/uploads/pictures
