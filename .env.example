# Sumber data: mock (default) | postgres
DATA_SOURCE=mock

# Triple-pool Postgres (hanya dipakai jika DATA_SOURCE=postgres)
# Ketiga URL wajib terisi untuk live SQL; jika ada yang kosong → fallback mock.
# DATABASE_URL_SIGA=postgres://user:pass@host:5432/sigabaru
# DATABASE_URL_WILAYAH=postgres://user:pass@host:5432/pk2025
# DATABASE_URL_DWH=postgres://user:pass@host:5432/dwh_pk2025

# Periode rekap DWH (default 2025)
# DWH_PERIODE=2025

# Master Wilayah API & Interactive Map SDK (BKKBN) — WAJIB untuk peta sebaran
# Browser memuat `${URL}/map/widget.js`. Jika kosong → error UI + tidak request /undefined/...
# Lokal: salin ke .env.local lalu restart `next dev` (atau rebuild).
# OpenShift: pass sebagai Docker/BuildConfig build-arg (lihat README); rebuild image.
# UAT (default di bawah). URL production belum terdokumentasi di repo — tanya tim Master Wilayah.
NEXT_PUBLIC_MASTER_WILAYAH_API_URL=https://master-wilayah-api-git-master-wilayah-api.apps.ocp-uat.bkkbn.go.id
