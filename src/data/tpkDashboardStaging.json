  "definisi": {
    "sasaran_per_tpk": {
      "numerator": "SUM satu nilai jml_keluarga_sasaran per TPKID unik dari tpk_detail; cek nilai konflik di dalam TPKID",
      "denominator": "COUNT TPKID valid atau jumlah kelompok TPK tercakup; status aktif harus dibuktikan sebelum memberi label aktif",
      "unit": "keluarga penugasan per TPK; unik lintas TPK belum dibuktikan"
    },
    "krs_per_tpk": {
      "numerator": "SUM total_prioritas satu kali per kode desa unik dari agg_all",
      "denominator": "TPK cakupan wilayah yang sepadan",
      "unit": "KRS per TPK; bukan jumlah KRS yang sudah didampingi"
    },
    "granularitas": "nasional > provinsi > kabupaten/kota > kecamatan > desa/kelurahan",
    "null": "Belum tersedia / perlu validasi"
  },
